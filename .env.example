# Mainspring environment example
#
# Copy the variables you need into your shell, password manager, direnv, or a
# local .env file that is not committed. Leave unused providers unset.

# Telegram notifications. Enable only after notify-test succeeds.
MAINSPRING_NOTIFY_ENABLED=0
MAINSPRING_TELEGRAM_BOT_TOKEN=
MAINSPRING_TELEGRAM_CHAT_ID=
MAINSPRING_NOTIFY_STALE_SECONDS=3600

# CLI/provider engines. Set only the provider used by --engine / --review-engine.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=

# Azure OpenAI via LiteLLM.
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# Local OpenAI-compatible servers such as MTPLX.
# Example:
#   OPENAI_API_BASE=http://127.0.0.1:18080/v1
#   OPENAI_API_KEY=local
OPENAI_API_BASE=
